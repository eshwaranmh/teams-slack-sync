{
  "manifest_version": 3,
  "name": "Teams → Slack Status Sync",
  "version": "1.1.0",
  "description": "Detects active Microsoft Teams (web) meetings and notifies a local server to update Slack status.",
  "permissions": ["alarms"],
  "host_permissions": [
    "http://localhost:3838/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://teams.microsoft.com/*",
        "https://*.teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://*.teams.live.com/*",
        "https://teams.cloud.microsoft/*",
        "https://*.cloud.microsoft/*"
      ],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
